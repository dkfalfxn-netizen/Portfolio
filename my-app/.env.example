# 다른 PC/환경에서 로컬 개발을 이어갈 때:
#   이 파일을 복사해 .env.local 로 저장한 뒤 아래 값을 채우세요.
#   Windows PowerShell: Copy-Item .env.example .env.local
#   Mac/Linux: cp .env.example .env.local
#
# Supabase 대시보드 → Project Settings → API / Data API
# Vercel에 넣은 값과 같은 프로젝트여야 동기화가 맞습니다.
# 프로덕션(Vercel)과 로컬에 동일한 키를 쓰려면: Vercel → Settings → Environment Variables 에서 복사.
#
# 전체 절차·Cron·Supabase SQL 순서는 저장소 루트 README.md 를 참고하세요.

# Data API 화면의 API URL (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 서버 전용 — /api/sync 동기화용. Git에 올리지 마세요.
# Legacy 탭의 service_role(JWT, eyJ로 시작) 사용을 권장합니다.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) 브라우저에서 Supabase 클라이언트를 쓸 때만 필요합니다.
# API Keys → Publishable key (sb_publishable_...)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 선택: 알림·Cron (프로덕션에서 켜는 경우 Vercel에도 동일하게 등록) ---

# Resend 대시보드 API Key — 이메일 알림(/api/alert/check) 발송 시
# RESEND_API_KEY=
# (선택) 커스텀 발신자. 예: Portfolio Alert <alert@yourdomain.com>
# RESEND_FROM=

# 텔레그램 가격 변동 알림
# @BotFather 에서 봇 생성 → TELEGRAM_BOT_TOKEN 발급
# TELEGRAM_BOT_TOKEN=
# 봇에게 메시지 전송 후 getUpdates API로 확인 → TELEGRAM_CHAT_ID
# TELEGRAM_CHAT_ID=

# Vercel Cron이 GET /api/alert/check 호출 시 Authorization: Bearer <값> 과 일치해야 함.
# 비우면 로컬/테스트에서 Cron GET 검증 없이 동작할 수 있음.
# CRON_SECRET=

# Prisma migrate 등 CLI만 쓸 때 (앱 런타임 필수 아님)
# DATABASE_URL=

# --- AI 데일리 마켓 인사이트 (필수) ---
# OpenAI 대시보드 → API Keys → Create new secret key
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- AI 데일리 마켓 인사이트 (선택) ---
# 분석할 유튜브 채널 수가 많거나 자막 수집 실패 시
# YouTube Data API v3 키를 발급하면 안정성↑ (현재 미사용, 확장용)
# https://console.cloud.google.com/ → YouTube Data API v3 활성화
# YOUTUBE_API_KEY=
